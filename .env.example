# Copy this file to .env and fill in your key(s). Never commit .env.

# Which LLM drives the agent: anthropic | google
LLM_PROVIDER=anthropic

# Anthropic (paid API credits)
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Google Gemini (free tier; key from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-google-key-here
GOOGLE_MODEL=gemini-3.8-flash

# Set to 1 to inject a one-off failure on the first request to page 2
SIMULATE_FAILURE=0
