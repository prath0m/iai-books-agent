# Copy this file to .env and fill in your key. Never commit .env.

# Google Gemini (free tier; key from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-google-key-here
GOOGLE_MODEL=gemini-3.5-flash
# Fallback models, tried in order if one fails (each has its own free daily quota)
GOOGLE_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Pace Gemini calls (free tier allows 5 requests/minute)
GOOGLE_REQUESTS_PER_MINUTE=4

# Set to 1 to inject a one-off failure on the first request to page 2
SIMULATE_FAILURE=0
